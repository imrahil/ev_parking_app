# Aggregated status API served by the Cloudflare Worker (worker/README.md).
# Fill in after `npx wrangler deploy`, e.g.:
#   VITE_API_URL=https://parking-status.<subdomain>.workers.dev/stations
# Leave empty to call ecarup.com directly from the browser (old behavior).
VITE_API_URL=https://parking-status.imrahil.workers.dev/stations

# Web Push public key (VAPID). Public by design — it is handed to the browser
# to identify the sender. Generate the pair once with:
#   npx web-push generate-vapid-keys
# then put the same public key in worker/wrangler.toml and the private one in
#   npx wrangler secret put VAPID_PRIVATE_KEY
# Leave empty to ship without the notification feature.
VITE_VAPID_PUBLIC_KEY=BCBN2UaX2RZoesiysIrZYAJHKLqULdCyd-lgveWflic5sceyCmpkV-q6d_zFPrLFhaoJnbBcs2LlRdXO-rO4ED8
